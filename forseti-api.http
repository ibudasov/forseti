# Cloud Run via `make cloud-proxy`: http://127.0.0.1:8080
# Local dev (`make up`): http://localhost:8000
@baseUrl = http://127.0.0.1:8080
@symbol = NVDA
@runId = replace-with-run-id

### Welcome
GET {{baseUrl}}/

### Health check
GET {{baseUrl}}/healthz

### Health check alias
GET {{baseUrl}}/health

### Liveness check
GET {{baseUrl}}/livez

### Liveness check alias
GET {{baseUrl}}/live

### Analyze a ticker (uses latest available data)
# Optional query parameters: include_trace=true|false, pipeline=linear|agentic.
# pipeline overrides may be disabled by the server (ALLOW_PIPELINE_OVERRIDE=false in cloud).
POST {{baseUrl}}/analyze?include_trace=true
Content-Type: application/json

{
  "ticker": "{{symbol}}"
}

### Demo ticker 1: NVDA
POST {{baseUrl}}/analyze?include_trace=true
Content-Type: application/json

{
  "ticker": "NVDA"
}

### Demo ticker 2: LMT
POST {{baseUrl}}/analyze?include_trace=true
Content-Type: application/json

{
  "ticker": "LMT"
}

### Demo ticker 3: OKLO
POST {{baseUrl}}/analyze?include_trace=true
Content-Type: application/json

{
  "ticker": "OKLO"
}

### Screen the universe
# Optional query parameter: verbose=true|false.
GET {{baseUrl}}/screening?verbose=true

### Universe diagnostics
GET {{baseUrl}}/diagnostics/universe

### Get a run trace
# Set @runId to a run ID returned by /analyze?include_trace=true.
GET {{baseUrl}}/runs/{{runId}}

### Get a ticker profile
GET {{baseUrl}}/ticker/{{symbol}}

### Get ticker evidence
GET {{baseUrl}}/ticker/{{symbol}}/evidence

### OpenAPI schema
GET {{baseUrl}}/openapi.json

### Swagger UI
GET {{baseUrl}}/docs

### Swagger OAuth redirect
GET {{baseUrl}}/docs/oauth2-redirect

### ReDoc
GET {{baseUrl}}/redoc
