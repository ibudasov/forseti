# Connection string used by the application and Alembic.
DATABASE_URL=postgresql://user:password@postgresql:5432/forseti

# These values are also consumed by docker-compose when an explicit DATABASE_URL is not provided.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=forseti
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432

# --- Vertex AI (RAG embeddings + Gemini synthesis) ---
# GCP project ID that has the Vertex AI API enabled. When unset, the RAG layer
# falls back to MockEmbeddingClient (zero vectors) and synthesis returns insufficient_data.
VERTEX_AI_PROJECT=forseti-505116
VERTEX_AI_LOCATION=europe-west4
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768
GEMINI_MODEL=gemini-2.0-flash-001

# Set to true to make RAG cloud failures raise instead of falling back silently
# (zero embedding vectors / insufficient_data). Use during cloud validation.
RAG_FAIL_LOUD=false

# --- ADK / google-genai Vertex routing (needed for the agentic workflow) ---
# google-adk routes through Vertex AI only when these are set.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=forseti-505116
GOOGLE_CLOUD_LOCATION=europe-west4

# --- Agent workflow ---
# Keep the deterministic pipeline by default; use agentic for ADK orchestration.
PIPELINE_MODE=linear
AGENT_MODEL_TEMPERATURE=0.2
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=1

# --- Alpha Vantage (earnings calendar) ---
# alphavantage.co/support/#api-key
# NOTE: function=EARNINGS_CALENDAR is a PREMIUM endpoint. A free-tier key gets an
# HTTP 200 whose body is {"Information": "...premium endpoint..."}, and ingestion
# now fails loudly instead of recording zero rows as a success.
ALPHA_VANTAGE_API_KEY=

# --- SEC EDGAR (fundamentals) ---
# The SEC requires a real contact address in the User-Agent and throttles or
# blocks generic ones. Use "AppName/version (you@example.com)".
EDGAR_USER_AGENT=Forseti/0.1 (your-email@example.com)
