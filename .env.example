# Connection string used by the application and Alembic.
DATABASE_URL=postgresql://user:password@postgresql:5432/forseti

# These values are also consumed by docker-compose when an explicit DATABASE_URL is not provided.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=forseti
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432

# RAG + Vector Database settings
EMBEDDING_MODEL_NAME=text-embedding-004
EMBEDDING_DIMENSION=768
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1
