# Cloud Run supplies PORT; this fallback also works for local container validation.
APP_ENV=cloud
PORT=8000
# Required: inject the URL from Secret Manager, never bake credentials into the image.
# Socket form: postgresql://USER@/forseti?host=/cloudsql/PROJECT:REGION:INSTANCE
# Percent-encode credentials.
DATABASE_URL=
# Per-process connection budget; see docs/database.md before increasing.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE_SECONDS=1800

# Required project IDs. Use the Cloud Run service identity (ADC), not a key file.
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_PROJECT=
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=europe-west4
VERTEX_AI_LOCATION=europe-west4
GEMINI_MODEL=gemini-2.0-flash-001
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
# Optional per-model pricing override; omit to use the application defaults.
# MODEL_PRICING_USD_PER_MILLION={"gemini-2.0-flash-001":{"input":0.10,"output":0.40}}

# Required safety policy: startup fails if these switches are unsafe.
RAG_FAIL_LOUD=true
DEBUG_LLM_IO=false
ALLOW_PIPELINE_OVERRIDE=false
# Unused while DEBUG_LLM_IO is false; temporary storage only.
DEBUG_LLM_IO_DIR=/tmp/forseti-llm-io

# Pipeline: linear|agentic. Analysts/critic: off|shadow|enforced.
PIPELINE_MODE=agentic
FUNDAMENTAL_AGENT_MODE=off
TECHNICAL_AGENT_MODE=off
CRITIC_MODE=off
# Contract: legacy|typed.
SYNTHESIZER_CONTRACT=legacy
AGENT_MODEL_TEMPERATURE=0.2
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=1

# Deterministic risk configuration.
ACCOUNT_CAPITAL_EUR=10000
RISK_PER_TRADE_PCT=0.01

# Job configuration. Inject provider keys from Secret Manager when needed.
ALPHA_VANTAGE_API_KEY=
# Required for SEC ingestion: supply a real contact identity.
EDGAR_USER_AGENT=
INGEST_ALLOW_MISSING_SOURCES=false
INGEST_REPORT_PATH=/tmp/forseti-ingest-report.json
INGEST_PRICE_PERIOD=2y
EARNINGS_FALLBACK_ENABLED=false
# Optional licensed transcript source, with a {ticker} placeholder.
EARNINGS_TRANSCRIPT_URL_TEMPLATE=
